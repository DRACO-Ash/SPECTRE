# SPECTRE environment configuration — copy to .env and fill in real values.
#
# In an App Store deployment these are set in the operator's Environment
# Variables tab, saved as a complete set, then applied. Do NOT set PORT there:
# the platform injects it, and any value typed in the tab overrides the
# injected one and breaks the readiness probe.

# REQUIRED. Signs session and CSRF tokens. The app refuses to boot if this is
# missing, shorter than 16 characters, or left at a placeholder value.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# REQUIRED on first boot. Creates the initial admin account when the user table
# is empty. If SPECTRE_ADMIN_PASS is blank, NO account is created and nobody can
# log in, though the app still passes every health check. Boot logs an error
# saying exactly that, so check the log if the login page rejects you.
SPECTRE_ADMIN_USER=admin
SPECTRE_ADMIN_PASS=

# BREAK-GLASS ONLY. Bootstrap runs solely on an empty user table, so editing
# SPECTRE_ADMIN_PASS later has no effect. Set this to true for ONE deploy to
# reset (or recreate) the admin account above, then unset it: left on, it
# resets the password on every restart.
# SPECTRE_ADMIN_RESET=true

# OPTIONAL. Logging verbosity: DEBUG, INFO, WARNING, ERROR.
SPECTRE_LOG_LEVEL=INFO

# OPTIONAL. Overrides where SPECTRE stores its data. Leave unset in the App
# Store: the FILE_STORAGE add-on injects STORAGE_MOUNT_PATH and the app reads
# it. Locally, unset means ./data.
# SPECTRE_DATA_DIR=/data

# OPTIONAL. Overrides the database. The POSTGRESQL add-on injects this
# automatically. Unset, SPECTRE uses SQLite under ./data (or SPECTRE_SQLITE_DIR)
# on the container's own filesystem, NOT in the data directory above: the
# FILE_STORAGE mount cannot host SQLite. That database is ephemeral in the
# container and does not survive a redeploy; attach PostgreSQL for durable data.
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/spectre

# OPTIONAL. Where the SQLite fallback keeps its file. Unset means ./data.
# SPECTRE_SQLITE_DIR=/var/lib/spectre

# OPTIONAL. Seconds before a pooled PostgreSQL connection is recycled. Default
# 300, below the idle cut-off of common managed proxies; 0 disables recycling.
# SPECTRE_DB_POOL_RECYCLE=300

# OPTIONAL. Directory for log files. Default: logs
# SPECTRE_LOG_DIR=logs

# DEVELOPMENT ONLY. The session cookie is Secure (HTTPS only) unless this is
# false. Set false only for a local plain-HTTP server or a test client.
# SPECTRE_COOKIE_SECURE=false

# PLATFORM ONLY. Set by the App Store's DAST scanner, never by an operator:
# with SECRET_KEY unset it lets the app boot on a throwaway per-process key.
# APPSTORE_DAST_SCAN=true

# NEVER set PORT here or in the App Store console. The app defaults to 8080 and
# honours the platform's injected value.
