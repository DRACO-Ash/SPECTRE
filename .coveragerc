# Standalone for the same reason as pytest.ini: pyproject.toml does not ship
# in the submission package. See that file's header.
[run]
source = spectre,tle_clustering
# SQLAlchemy's async bridge switches greenlets on every await. Without this,
# coverage loses the trace after `await session.execute(...)` and under-reports
# lines that demonstrably run, which would understate coverage to SonarQube.
concurrency = thread,greenlet
omit =
    tests/*
    spectre/app_logging/config.py

[report]
fail_under = 70
show_missing = true
