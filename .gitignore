# The runtime data volume at the repository root, ANCHORED.
#
# This was "data/", which gitignore matches at any depth, so it silently
# swallowed spectre/data/ as well. The JSON files already in spectre/data/
# survive only because they were committed before the rule existed; anything
# added there since has been ignored without a word. That is how the bundled
# HRR bootstrap list came to be missing from every build.
/data/
dist/
dmypy.json
eggs/
ehthumbs.db
# Anchored to the root: unanchored, these ignored any spectre/lib/ or
# tle_clustering/env/ a contributor added, silently (audit F-291).
/env/
htmlcov/
/lib/
/lib64/
/logs/
memory/
/parts/
